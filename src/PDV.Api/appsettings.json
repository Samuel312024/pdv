{
  //"DatabaseProvider": "SqlServer",

  "Jwt": {
    "Issuer": "PDV.Api",
    "Audience": "PDV.Web",
    "Key": "",
    "ExpiresInHours": 8
  },

  "Pdv": {
    "Version": "0.1.0",
    "DownloadUrl": "/api/instalador/pdv/download",
    "Mandatory": false
  },

  "CatalogoProdutosExternos": {
    "Habilitado": true,
    "Provedor": "OpenFoodFacts",
    "BaseUrl": "https://world.openfoodfacts.org/",
    "ApiKey": null,
    "TokenHeaderName": "X-Cosmos-Token",
    "TimeoutSeconds": 8
  },

  "ProdutoImagemReconhecimento": {
    "Habilitado": true,
    "ScriptRelativePath": "Python/product_image_lookup.py",
    "PythonExecutable": null,
    "PythonArguments": null,
    "TesseractExecutablePath": null,
    "OcrLanguages": "por+eng",
    "TimeoutSeconds": 20
  },

  "NfeSefaz": {
    "PreferDirectConnectionWithoutProxy": true,
    "AllowSystemProxyFallback": true,
    "ForceHttp11": true,
    "Overrides": {
      "UF_EXEMPLO": {
        "Homologacao": {
          "AutorizacaoUrl": null,
          "RetAutorizacaoUrl": null,
          "StatusServicoUrl": null
        },
        "Producao": {
          "AutorizacaoUrl": null,
          "RetAutorizacaoUrl": null,
          "StatusServicoUrl": null
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}